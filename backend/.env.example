# ---- Pick ONE provider (or leave all blank for offline mode) ----------------

# Claude (default model: claude-opus-5-5; set ANTHROPIC_MODEL=claude-haiku-4-5 for a cheaper bot)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI (OPENAI_MODEL is required, pick the model id you want to use)
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Force a provider: anthropic | openai | offline
# LLM_PROVIDER=

# ---- Behaviour ---------------------------------------------------------------
# COMPANY_NAME=Fernhill Cloud
# DOCS_DIR=../docs
# TOP_K=4
# RATE_LIMIT_PER_MINUTE=20
# CORS_ORIGINS=http://localhost:3000

# Set a token to enable POST /api/reindex (re-read the docs folder without a restart)
# ADMIN_TOKEN=
